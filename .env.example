# Copiez ce fichier vers .env.local et remplissez vos clés.
# .env.local est git-ignoré : vos clés ne seront jamais committées.

# =========================================================================
#  FOURNISSEUR DE MODÈLE — « Claude ou autre »
#  Choisissez le fournisseur. Défaut : anthropic.
# =========================================================================
# LLM_PROVIDER=anthropic        # anthropic | openai
# LLM_MODEL=                    # (optionnel) force le modèle du chat, tous fournisseurs
# STORY_MODEL=                  # (optionnel) modèle dédié à la génération d'histoire

# ---- Voie Anthropic (Claude) : boucle agentique complète (recherche web + outils) ----
# Clé API — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# (optionnel) Modèle. Défaut chat : claude-opus-4-8 — défaut histoire : claude-sonnet-4-6
# ANTHROPIC_MODEL=claude-opus-4-8

# ---- Voie compatible OpenAI : OpenAI, OpenRouter, Mistral, Groq, vLLM, Ollama… ----
# Activez avec LLM_PROVIDER=openai, puis :
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1     # OpenRouter: https://openrouter.ai/api/v1
                                                # Ollama local: http://localhost:11434/v1
# OPENAI_MODEL=gpt-4o-mini
# Note : sur cette voie, le chat est en streaming simple (pas de recherche web
# ni d'outils serveur, réservés à Claude).
