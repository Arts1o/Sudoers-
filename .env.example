# Copiez ce fichier vers .env.local et remplissez votre clé.
# .env.local est git-ignoré : vos clés ne seront jamais committées.

# Clé API Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# (optionnel) Modèle à utiliser. Défaut : claude-opus-4-8
# Alternatives : claude-sonnet-4-6 (plus rapide/moins cher), claude-haiku-4-5
ANTHROPIC_MODEL=claude-opus-4-8
